    "en": {
      "title": "Redirep 45 RSF",
      "h1": "Mapei Redirep 45 RSF",
      "description": "Redirep 45 RSF is a fibre-reinforced, shrinkage-compensated, thixotropic repair mortar for concrete with fast setting and high frost resistance.",
      "blocks": [
        {
          "type": "image",
          "alt": "Mapei logotyp",
          "href": "/produkter/mapei",
          "width": 1920,
          "height": 493,
          "src": "/assets/img/mapei-1.webp",
          "gen": true
        },
        {
          "type": "image",
          "alt": "Mapei Redirep 45 RSF",
          "src": "/assets/img/mapei-redirep-45-rsf-main.webp",
          "width": 439,
          "height": 830,
          "gen": true
        },
        {
          "type": "text",
          "html": "Redirep 45 RSF is a fibre-reinforced, shrinkage-compensated, thixotropic repair mortar for concrete with fast setting and high frost resistance. It is intended for repairing damage in concrete substrates and meets EN 1504-3, class R4. Supplied in 25 kg bags.",
          "gen": true
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            "Fast setting and fast strength development",
            "Shrinkage-compensated, dimensionally stable",
            "Very good adhesion to concrete",
            "Frost resistant, suited to the Nordic climate",
            "Low permeability, withstands marine environments",
            "Class R4 to EN 1504-3, EC1 Plus"
          ],
          "gen": true
        },
        {
          "type": "stat",
          "label": "Consumption",
          "value": "2 kg/m²",
          "unit": "per mm of thickness",
          "meta": "3-40 mm per layer",
          "note": "Theoretical consumption. Actual consumption depends on the unevenness of the substrate.",
          "usage": true,
          "gen": true
        },
        {
          "type": "button",
          "kind": "download",
          "text": "Technical data sheet (TDS)",
          "href": "/assets/docs/mapei-redirep-45-rsf-tekniskt-datablad.pdf",
