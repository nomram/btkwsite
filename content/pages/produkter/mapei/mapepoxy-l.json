    "en": {
      "title": "Mapepoxy L",
      "h1": "Mapei Mapepoxy L",
      "description": "Mapepoxy L is a two-component, fast-curing epoxy adhesive for load-bearing bonding of fresh concrete to old concrete, old concrete to old concrete and steel to concrete.",
      "blocks": [
        {
          "type": "image",
          "alt": "Mapei logotyp",
          "href": "/produkter/mapei",
