    "en": {
      "title": "Driller",
      "h1": "Marini Driller",
      "description": "Driller is a pneumatic drilling unit for the holes the diamond wire passes through. With a pneumatic rotary head and a down-the-hole (DTH) hammer it reaches depths of 25 - 30 metres even in rock with ",
      "blocks": [
        {
          "type": "image",
          "alt": "Marini logotyp",
          "href": "/produkter/marini",
          "width": 637,
          "height": 86,
          "src": "/assets/img/logo-marini.webp",
          "gen": true
