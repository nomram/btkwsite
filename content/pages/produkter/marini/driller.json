        {
          "type": "image",
          "alt": "Marini Driller",
          "file": "/assets/img/marini-drill-driller.webp",
          "width": 307,
          "height": 454,
          "src": "/assets/img/marini-drill-driller.webp",
          "gen": true
        },
        {
          "type": "carousel",
          "autoplay": false,
          "interval": 6,
