    "en": {
      "title": "Gran Fil Electronic",
      "h1": "Marini Gran Fil Electronic",
      "description": "Gran Fil Electronic is a diamond wire saw from Marini's granite line with variable wire speed (0 - 40 m/s) controlled by an inverter. Main motor 37 / 45 kW, weight 1,620 / 1,700 kg.",
      "blocks": [
        {
