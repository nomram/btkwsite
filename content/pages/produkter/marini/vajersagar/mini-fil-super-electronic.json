    "en": {
      "title": "Mini Fil Super Electronic",
      "h1": "Marini Mini Fil Super Electronic",
      "description": "Mini Fil Super Electronic is a diamond wire saw from Marini's granite line with variable wire speed controlled by an inverter. Main motor 11 / 15 / 18 kW, weight 900 / 920 / 950 kg.",
      "blocks": [
        {
