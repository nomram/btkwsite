    "en": {
      "title": "Driller ID",
      "h1": "Marini Driller ID",
      "description": "Driller ID is the hydraulic version of Driller: the same light drilling unit for the holes the diamond wire passes through, but with a hydraulic rotary head and hydraulic feed from a power pack with a",
      "blocks": [
        {
          "type": "image",
