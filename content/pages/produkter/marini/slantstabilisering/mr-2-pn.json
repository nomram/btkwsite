    "en": {
      "title": "MR 2 PN",
      "h1": "Marini MR 2 PN",
      "seoTitle": "Marini MR 2 PN drill rig for slope stabilisation | Betongakuten",
      "description": "MR 2 PN is a pneumatic drilling unit from Marini's MR line for slope stabilisation and micropiling. See it in 3D, with technical data and brochure.",
