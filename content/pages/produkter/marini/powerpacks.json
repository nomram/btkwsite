    "es": {
      "title": "Grupos hidráulicos (powerpacks)",
      "h1": "Grupos hidráulicos (powerpacks)",
      "description": "Los powerpacks de Marini son grupos hidráulicos diseñados para accionar equipos de perforación y otra maquinaria pesada en los sectores de la construcción y la obra civil…",
      "blocks": [
        {
          "type": "image",
          "alt": "Marini logotipo",
          "href": "/produkter/marini",
          "width": 928,
          "height": 542,
