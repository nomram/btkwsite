    "no": {
      "title": "Wiresager",
      "h1": "Wiresager",
      "description": "Marini tilbyr et bredt utvalg av wiresager for ulike typer steinbrudd- og bergarbeid.",
      "blocks": [
        {
          "type": "image",
          "alt": "Marini logo",
          "href": "/produkter/marini",
          "width": 637,
          "height": 86,
          "src": "/assets/img/logo-marini.webp"
        },
        {
          "type": "image",
          "alt": "Wiresager: bilde 2",
