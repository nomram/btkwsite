    "en": {
      "title": "HEMH",
      "h1": "HEMH",
      "description": "The largest drill mast variant is the HEMH (Hydraulic Excavator Mount Heavy), intended for excavators weighing around 30 tonnes. For the very largest…",
      "blocks": [
