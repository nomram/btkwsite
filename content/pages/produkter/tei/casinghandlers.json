    "sv": {
      "title": "Casinghandlers",
      "h1": "Casinghandlers",
      "seoTitle": "Casinghandler HCC10X och HCC16X från TEI | Betongakuten",
      "description": "Hydrauliska casinghandlers från TEI som lyfter och placerar foderrör och borrstänger med grävmaskinen, utan medhjälpare i riskzonen. HCC10X och HCC16X.",
      "blocks": [
