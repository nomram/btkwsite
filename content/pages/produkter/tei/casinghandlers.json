    "lt": {
      "title": "Vamzdžių manipuliatoriai",
      "h1": "Vamzdžių manipuliatoriai",
      "seoTitle": "TEI vamzdžių manipuliatoriai HCC10X ir HCC16X | Betongakuten",
      "description": "Hidrauliniai TEI manipuliatoriai, kuriais ekskavatorius kelia ir stato apsauginius vamzdžius bei gręžimo štangas be pagalbininko pavojaus zonoje. HCC10X ir HCC16X.",
      "blocks": [
        {
          "type": "image",
          "alt": "TEI Rock Drills",
          "href": "/produkter/tei",
          "width": 1920,
          "height": 1117,
          "src": "/assets/img/tei-2.webp"
        },
        {
          "type": "text",
          "html": "TEI vamzdžių manipuliatorius yra hidraulinis griebtuvas, montuojamas ant ekskavatoriaus strėlės, kuris kelia, laiko ir stato apsauginius vamzdžius bei gręžimo štangas. Niekam nereikia stovėti pavojaus zonoje ir laikyti vamzdžio rankomis, o vamzdis atsiduria tiesiai ir centre virš gręžimo stiebo."
        },
