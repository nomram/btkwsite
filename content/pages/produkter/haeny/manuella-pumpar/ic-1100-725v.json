    "en": {
      "title": "Häny IC 1100/725",
      "h1": "Häny IC 1100/725",
      "description": "Compact Grout Plant IC 1100/725. The compact grout plants consist of the proven, standard Häny components of a mixer, agitator, and grout pump. This setup is suitable for a wide range of applications ",
      "blocks": [
        {
          "type": "image",
          "alt": "HÄNY",
          "href": "/produkter/haeny",
