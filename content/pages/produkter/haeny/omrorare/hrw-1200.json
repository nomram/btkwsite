    "lt": {
      "title": "Häny HRW 1200",
      "h1": "Häny HRW 1200",
      "description": "Maišiklis HRW 1200. Maišikliai užtikrina nepertraukiamą darbą išlaikydami ir homogenizuodami sumaišytą suspensiją bei šalindami oro burbuliukus lėtai besisukančia mentimi. Lygio jutikliai (pasirinktinai)…",
      "blocks": [
        {
          "type": "image",
          "alt": "HÄNY",
          "href": "/produkter/haeny",
          "width": 236,
          "height": 128,
